#!/bin/bash
#BSUB -J superlinear_cpu_g3_o8
#BSUB -q 33
#BSUB -n 200
#BSUB -R "span[ptile=40]"
#BSUB -e %J.err
#BSUB -o %J.out

set -e
module purge
module load compiler/2022.1.0 mpi/2021.6.0 mkl/2022.2.0 gcc/11.2.0

cd "$LS_SUBCWD"

export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export I_MPI_FABRICS=shm:ofi
# Recompute dataset neighborhoods to limit memory on queue 33.
export MLIP_CACHE_NEIGHBORHOODS=0

bin=/work/phy-weigw/20260321_Test/superlinear-radial-coefficient-gate-work-codex/bin/mlp-sus2
train_cfg=./train.cfg
prefix=outer8gate3_cpu
init_mtp=ini.mtp
np=$(wc -l < "$LSB_DJOB_HOSTFILE")

# Fresh training: use a new directory containing train.cfg.
# max-iter counts BFGS steps, not PyTorch epochs.
mpiexec.hydra -machinefile "$LSB_DJOB_HOSTFILE" -np "$np" \
  "$bin" train "$train_cfg" \
  --init-sh --inline-sh-model="$init_mtp" \
  --superlinear-mode=radial-coefficient-gate \
  --species-count=8 --l-max=4 --k-max=8 --body-order=6 \
  --body-l-max=4,4,4,2,1 --cutoff=6.0 \
  --radial-basis-size=8 --radial-basis-type=RBChebyshev_sss --scaling-map=K \
  --sh-factor-pruning=same-k --outer-k-rank=8 \
  --two-layer-gate --two-layer-gate-mode=mu-scalar-full \
  --two-layer-gate-factor-pruning=q-total --two-layer-gate-k-rank=3 \
  --two-layer-gate-body-order=4 --two-layer-gate-shared-radial \
  --init-params=same --init-random-seed=20260907 --scal-range=3.5,1.5 \
  --adaptive-radial-initialization=balanced --adaptive-radial-init-relative-rms=0.03 \
  --energy-weight=1 --force-weight=0.1 --stress-weight=0.01 --force-loss=l2 \
  --weighting=vibrations --std-weight=0 --stdd-weight=0 \
  --gate-x-l2=0 --radial-smooth=1e-6 --scalar-weight-l2-preset=recommended \
  --optimizer=bfgs --bfgs-line-search=wolfe --radial-parameterization=weight-norm \
  --bfgs-coordinate-normalization=efs-gn \
  --max-iter=5000 --optimizer-conv-tol=0 \
  --curr-pot-name="${prefix}_current.mtp" \
  --trained-pot-name="${prefix}_p.mtp" --best-pot-name="${prefix}_best.mtp" \
  > "${prefix}.log" 2>&1
