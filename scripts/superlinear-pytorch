#!/bin/bash
# Entry point for the maintained adaptive-radial PyTorch interface.
set -eo pipefail
# Activate the separately installed PyTorch environment before invoking this wrapper.
# Optionally point to a source checkout and a specific Python interpreter.
if [[ -n ${SUPERLINEAR_PYTORCH_ROOT:-} ]]; then
  export PYTHONPATH="$SUPERLINEAR_PYTORCH_ROOT${PYTHONPATH:+:$PYTHONPATH}"
fi
export SUS2SHPT_ADAPTIVE_KERNEL=${SUS2SHPT_ADAPTIVE_KERNEL:-vectorized}
exec "${SUPERLINEAR_PYTHON:-python}" -m sus2shpt.cli "$@"
